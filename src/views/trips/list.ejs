<%- include('../partials/header') %>
    <h1><%- title %></h1>

    <div id="filters">
        Search by Region:
        <select id="region-filter">
            <option value="all">All Regions</option>
            <% regions.forEach((region)=> { %>
                <option value="<%= region %>" <%=query.region===region ? 'selected' : '' %>><%=
                        region.charAt(0).toUpperCase() + region.slice(1) %>
                </option>
                <% }); %>
        </select>

        Search by Season:
        <select id="season-filter">
            <option value="all">Any Season</option>
            <% seasons.forEach((season)=> { %>
                <option value="<%= season %>" <%=query.season===season ? 'selected' : '' %>><%=
                        season.charAt(0).toUpperCase() + season.slice(1) %>
                </option>
                <% }); %>
        </select>
    </div>

    <section id="trips-list" class="routes-grid"></section>

    <template class="trips-card-template">
        <article class="trips-card">

            <div class="trip-image">
                <img src="" alt="" class="imageUrl">
            </div>

            <div class="name">
                <h2 class="tripName"></h2>
            </div>

            <div class="desc">
                <p class="trip-description"></p>
            </div>

            <div class="other-details">
                <p class="duration"></p>
                <p class="distance"></p>
                <p class="bestSeason"></p>
            </div>

            <div class="view-details">
                <a href="" class="specific-trip">View Details</a>
            </div>
        </article>
    </template>

    <%- include('../partials/footer') %>